<%# Sits behind an <img> inside a `relative` tile. When the file fails to load
    - most often a blob missing from S3 (#346) - .image-error collapses the img
    and this shows through instead of the browser's broken-image glyph. %>
<div class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-olive-100 to-olive-200">
  <svg class="w-1/2 h-1/2 text-olive-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="0.75" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
  </svg>
</div>
