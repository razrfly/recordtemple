<div class="mx-auto max-w-2xl px-6 py-12 md:max-w-3xl lg:max-w-7xl lg:px-10">
  <header class="mb-10">
    <h1 class="font-display text-4xl tracking-tight text-olive-950 sm:text-5xl">Discogs Review Queue</h1>
    <p class="mt-3 text-lg text-olive-600">Manually link high-value records to Discogs releases</p>
  </header>

  <%# Stats cards %>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-white rounded-2xl shadow-sm ring-1 ring-olive-900/5 p-4">
      <div class="text-sm font-medium text-olive-600">High Value ($100+)</div>
      <div class="mt-1 text-2xl font-semibold text-red-600"><%= number_with_delimiter(@stats[:high_value]) %></div>
    </div>
    <div class="bg-white rounded-2xl shadow-sm ring-1 ring-olive-900/5 p-4">
      <div class="text-sm font-medium text-olive-600">Medium Value ($25-99)</div>
      <div class="mt-1 text-2xl font-semibold text-amber-600"><%= number_with_delimiter(@stats[:medium_value]) %></div>
    </div>
    <div class="bg-white rounded-2xl shadow-sm ring-1 ring-olive-900/5 p-4">
      <div class="text-sm font-medium text-olive-600">Skipped</div>
      <div class="mt-1 text-2xl font-semibold text-olive-400"><%= number_with_delimiter(@stats[:skipped]) %></div>
    </div>
    <div class="bg-white rounded-2xl shadow-sm ring-1 ring-olive-900/5 p-4">
      <div class="text-sm font-medium text-olive-600">Current Queue</div>
      <div class="mt-1 text-2xl font-semibold text-olive-950"><%= number_with_delimiter(@stats[:total]) %></div>
    </div>
  </div>

  <%# Pill-style navigation %>
  <div class="mb-8">
    <nav class="flex gap-2 flex-wrap">
      <%= link_to admin_discogs_review_index_path(scope: "high_value"),
          aria: @scope == 'high_value' ? { current: "page" } : {},
          class: "px-4 py-2.5 text-sm font-medium rounded-full transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-olive-600 focus-visible:ring-offset-2 #{@scope == 'high_value' ? 'bg-olive-950 text-white' : 'bg-olive-200 text-olive-950 hover:bg-olive-300'}" do %>
        High Value ($100+)
      <% end %>
      <%= link_to admin_discogs_review_index_path(scope: "medium_value"),
          aria: @scope == 'medium_value' ? { current: "page" } : {},
          class: "px-4 py-2.5 text-sm font-medium rounded-full transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-olive-600 focus-visible:ring-offset-2 #{@scope == 'medium_value' ? 'bg-olive-950 text-white' : 'bg-olive-200 text-olive-950 hover:bg-olive-300'}" do %>
        Medium Value ($25-99)
      <% end %>
      <%= link_to admin_discogs_review_index_path(scope: "skipped"),
          aria: @scope == 'skipped' ? { current: "page" } : {},
          class: "px-4 py-2.5 text-sm font-medium rounded-full transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-olive-600 focus-visible:ring-offset-2 #{@scope == 'skipped' ? 'bg-olive-950 text-white' : 'bg-olive-200 text-olive-950 hover:bg-olive-300'}" do %>
        Skipped
      <% end %>
    </nav>
  </div>

  <%# Reuse full record collection component with both grid and list views %>
  <%= render 'records/record_collection',
      records: @records,
      pagy: @pagy,
      filtered_count: @stats[:total],
      total_count: @stats[:total],
      form_url: admin_discogs_review_index_path(scope: @scope),
      turbo_frame: "discogs_review_list",
      show_sort: false,
      show_filter_chips: false,
      show_view_toggle: true,
      show_actions: true,
      action_path: ->(record) { admin_discogs_review_path(record) },
      action_label: "Review",
      grid_cols: "grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5" %>
</div>
