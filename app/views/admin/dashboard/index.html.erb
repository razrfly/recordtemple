<div class="mx-auto max-w-2xl px-6 py-12 md:max-w-3xl lg:max-w-7xl lg:px-10">
  <header class="mb-10">
    <h1 class="font-display text-4xl tracking-tight text-olive-950 sm:text-5xl">Admin</h1>
    <p class="mt-3 text-lg text-olive-600">RecordTemple administration</p>
  </header>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <%= link_to admin_records_path, class: "group flex flex-col gap-3 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-olive-900/5 hover:ring-olive-900/20 transition-shadow" do %>
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-olive-100 text-olive-700 group-hover:bg-olive-200 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
          </svg>
        </div>
        <h2 class="text-base font-semibold text-olive-950">Value Explorer</h2>
      </div>
      <p class="text-sm text-olive-500">Collection valuation with condition-adjusted pricing and confidence scoring.</p>
    <% end %>

    <%= link_to admin_discogs_review_index_path, class: "group flex flex-col gap-3 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-olive-900/5 hover:ring-olive-900/20 transition-shadow" do %>
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-olive-100 text-olive-700 group-hover:bg-olive-200 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
          </svg>
        </div>
        <h2 class="text-base font-semibold text-olive-950">Discogs Review</h2>
      </div>
      <p class="text-sm text-olive-500">Review and link records against Discogs listings for pricing data.</p>
    <% end %>

    <%= link_to "/admin/sidekiq", class: "group flex flex-col gap-3 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-olive-900/5 hover:ring-olive-900/20 transition-shadow" do %>
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-olive-100 text-olive-700 group-hover:bg-olive-200 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 0 1-3-3m3 3a3 3 0 1 0 6 0m-6 0H3m16.5 0a3 3 0 0 0 3-3m-3 3a3 3 0 1 1-6 0m6 0h1.5m-7.5 0v-9m0 9V5.25A2.25 2.25 0 0 1 12 3h0a2.25 2.25 0 0 1 2.25 2.25v9" />
          </svg>
        </div>
        <h2 class="text-base font-semibold text-olive-950">Sidekiq</h2>
      </div>
      <p class="text-sm text-olive-500">Monitor background job queues, retries, and scheduled work.</p>
    <% end %>
  </div>
</div>
