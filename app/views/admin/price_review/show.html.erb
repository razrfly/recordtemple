<div class="mx-auto max-w-4xl px-6 py-12">
  <%# Back link %>
  <div class="mb-4">
    <%= link_to admin_record_path(@record), class: "inline-flex items-center text-sm text-olive-600 hover:text-olive-950 transition-colors" do %>
      <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      Back to Record
    <% end %>
  </div>

  <%# Flash messages %>
  <% if flash[:alert] %>
    <div class="mb-4 rounded-xl bg-red-50 p-4 ring-1 ring-red-200">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm font-medium text-red-800"><%= flash[:alert] %></p>
        </div>
      </div>
    </div>
  <% end %>

  <%# Compact record details bar %>
  <div class="mb-6 bg-white shadow-sm rounded-xl ring-1 ring-olive-900/5 p-4">
    <div class="flex items-center gap-4">
      <%# Cover image %>
      <% if @record.cover.present? %>
        <%= image_tag @record.cover.variant(resize_to_fill: [64, 64]),
            class: "h-16 w-16 rounded-lg object-cover ring-1 ring-olive-900/10 flex-shrink-0",
            loading: "lazy" %>
      <% else %>
        <div class="h-16 w-16 rounded-lg bg-olive-100 flex items-center justify-center ring-1 ring-olive-900/10 flex-shrink-0">
          <svg class="h-8 w-8 text-olive-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
          </svg>
        </div>
      <% end %>

      <%# Metadata %>
      <div class="flex-1 min-w-0">
        <h2 class="font-display text-lg font-bold text-olive-950"><%= @record.artist&.name %></h2>
        <p class="text-sm text-olive-600">
          <%= [@record.label&.name, @record.record_format_name.presence, @record.yearbegin.presence].compact.join(" · ") %>
        </p>
      </div>
    </div>
  </div>

  <%# Currently Linked Price panel %>
  <div class="mb-6 bg-white shadow-sm rounded-xl ring-1 ring-olive-900/5 overflow-hidden">
    <div class="px-6 py-4 border-b border-olive-200 bg-olive-50">
      <h2 class="font-display text-lg font-medium text-olive-950">Currently Linked Price</h2>
    </div>
    <div class="p-6">
      <% if @record.price.present? %>
        <p class="text-2xl font-semibold tabular-nums text-olive-950">
          $<%= number_with_precision(@record.price.price_high, precision: 0) %>
        </p>
        <p class="mt-1 text-sm text-olive-600">
          Range: $<%= @record.price.price_low %> – $<%= @record.price.price_high %>
        </p>
        <% if @record.price.detail.present? %>
          <p class="mt-1 text-xs text-olive-500"><%= @record.price.detail %></p>
        <% end %>
        <% if @record.price.footnote.present? %>
          <p class="mt-1 text-xs text-olive-400 italic"><%= @record.price.footnote %></p>
        <% end %>
        <div class="mt-4">
          <%= button_to "Clear price link",
              clear_admin_price_review_path(@record),
              method: :post,
              class: "inline-flex items-center px-3 py-1.5 border border-olive-300 shadow-sm text-xs font-medium rounded-lg text-olive-700 bg-white hover:bg-olive-50 transition-colors" %>
        </div>
      <% else %>
        <p class="text-sm text-olive-400">No price currently linked.</p>
      <% end %>
    </div>
  </div>

  <%# Search panel %>
  <div class="bg-white shadow-sm rounded-xl ring-1 ring-olive-900/5 overflow-hidden">
    <div class="px-6 py-4 border-b border-olive-200 bg-olive-50">
      <h2 class="font-display text-lg font-medium text-olive-950">Search Price Guide</h2>
    </div>
    <div class="p-6">
      <%# Search form %>
      <%= form_with url: search_admin_price_review_path(@record), method: :post, data: { turbo: false }, class: "mb-6" do |f| %>
        <%= f.label :query, "Search price guide", class: "sr-only" %>
        <div class="flex space-x-2">
          <%= f.text_field :query,
              value: params[:query].presence || @auto_query,
              placeholder: "Search by artist, label, detail…",
              class: "flex-1 block w-full rounded-xl border-olive-300 shadow-sm focus:border-olive-500 focus:ring-olive-500 text-sm" %>
          <%= f.submit "Search",
              class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-xl text-white bg-olive-950 hover:bg-olive-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-olive-500 transition-colors" %>
        </div>
      <% end %>

      <%# Search results %>
      <% if @candidates.present? %>
        <p class="text-xs text-olive-500 mb-3"><%= @candidates.size %> result<%= @candidates.size == 1 ? "" : "s" %></p>
        <div class="space-y-4">
          <% @candidates.each do |candidate| %>
            <% is_current = candidate.id == @record.price_id %>
            <div class="border <%= is_current ? "border-olive-400 bg-olive-50/50" : "border-olive-200 hover:border-olive-400 hover:bg-olive-50/50" %> rounded-xl p-4 transition-colors">
              <div class="flex items-start gap-3">
                <div class="flex-1 min-w-0">
                  <p class="text-2xl font-semibold tabular-nums text-olive-950">
                    $<%= number_with_precision(candidate.price_high, precision: 0) %>
                  </p>
                  <p class="mt-0.5 text-sm text-olive-600">
                    Range: $<%= candidate.price_low %> – $<%= candidate.price_high %>
                  </p>
                  <% if candidate.detail.present? %>
                    <p class="mt-0.5 text-xs text-olive-500"><%= candidate.detail %></p>
                  <% end %>
                  <% if candidate.footnote.present? %>
                    <p class="mt-0.5 text-xs text-olive-400 italic"><%= candidate.footnote %></p>
                  <% end %>
                  <p class="mt-1 text-xs text-olive-400">
                    <%= [candidate.cached_label, candidate.media_type, [candidate.yearbegin, candidate.yearend].compact.join("–")].compact_blank.join(" · ") %>
                  </p>
                </div>
                <div class="flex-shrink-0 flex items-center gap-2">
                  <% if is_current %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-olive-100 text-olive-800">★ Current</span>
                  <% end %>
                  <%= button_to "Set as Price",
                      link_admin_price_review_path(@record, price_id: candidate.id),
                      method: :post,
                      class: "inline-flex items-center px-2.5 py-1.5 border border-transparent shadow-sm text-xs font-medium rounded-lg text-white bg-olive-950 hover:bg-olive-800 transition-colors" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% elsif request.post? || params[:query].present? %>
        <div class="text-center py-8">
          <svg class="mx-auto h-12 w-12 text-olive-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <h3 class="mt-2 text-sm font-medium text-olive-950">No results found</h3>
          <p class="mt-1 text-sm text-olive-600">Try a different query.</p>
        </div>
      <% else %>
        <div class="text-center py-8">
          <p class="text-sm text-olive-500">Search returned no results — try editing the query above.</p>
        </div>
      <% end %>

      <%# Create new entry %>
      <div class="mt-6 pt-6 border-t border-olive-200">
        <h4 class="text-sm font-medium text-olive-950 mb-2">Nothing matches?</h4>
        <%= render "prices/create_panel",
            default_artist_id: @record.artist_id,
            default_label_id: @record.label_id,
            default_format_id: @record.record_format_id,
            link_url: link_admin_price_review_path(@record) %>
      </div>

      <%# Manual ID entry %>
      <div class="mt-6 pt-6 border-t border-olive-200">
        <h4 class="text-sm font-medium text-olive-950 mb-2">Or enter Price ID directly</h4>
        <%= form_with url: link_admin_price_review_path(@record), method: :post, local: true, class: "flex space-x-2" do |f| %>
          <%= f.label :price_id, "Price ID", class: "sr-only" %>
          <%= f.number_field :price_id,
              placeholder: "e.g. 12345",
              min: 1,
              class: "block w-40 rounded-xl border-olive-300 shadow-sm focus:border-olive-500 focus:ring-olive-500 text-sm" %>
          <%= f.submit "Set by ID",
              class: "inline-flex items-center px-3 py-2 border border-transparent shadow-sm text-sm font-medium rounded-xl text-white bg-olive-950 hover:bg-olive-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-olive-500 transition-colors" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
