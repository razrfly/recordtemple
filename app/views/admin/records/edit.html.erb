<div class="mx-auto max-w-2xl px-6 py-12 lg:px-10">
  <header class="mb-8">
    <%= link_to "← Back to Value Explorer", admin_records_path, class: "text-sm text-olive-600 hover:text-olive-950 transition-colors" %>
    <div class="mt-4">
      <h1 class="font-display text-3xl tracking-tight text-olive-950">Edit Record</h1>
      <p class="mt-1 text-lg text-olive-600">
        <%= @record_with_valuation[:artist_name] || "Unknown Artist" %>
        <% if @record_with_valuation[:label_name].present? %>
          <span class="text-olive-400">·</span> <%= @record_with_valuation[:label_name] %>
        <% end %>
        <% if @record_with_valuation[:format_name].present? %>
          <span class="text-olive-400">·</span> <%= @record_with_valuation[:format_name] %>
        <% end %>
      </p>
    </div>
  </header>

  <%# Price comparison grid %>
  <div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
    <%# Guide price card %>
    <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-olive-900/5">
      <p class="text-xs font-semibold uppercase tracking-wide text-olive-500 mb-3">Guide Price</p>
      <% if @record_with_valuation[:price_high].to_i > 0 %>
        <p class="text-2xl font-semibold tabular-nums text-olive-950">
          $<%= number_with_delimiter(@record_with_valuation[:adjusted_value].to_f.round(0)) %>
          <span class="text-sm font-normal text-olive-500">(adjusted)</span>
        </p>
        <p class="mt-1 text-sm text-olive-600">
          Range: $<%= @record_with_valuation[:price_low] %> – $<%= @record_with_valuation[:price_high] %>
        </p>
        <% if @record_with_valuation[:price_detail].present? %>
          <p class="mt-1 text-xs text-olive-500"><%= @record_with_valuation[:price_detail] %></p>
        <% end %>
        <% if @record_with_valuation[:price_footnote].present? %>
          <p class="mt-1 text-xs text-olive-400 italic"><%= @record_with_valuation[:price_footnote] %></p>
        <% end %>
      <% else %>
        <p class="text-sm text-olive-400">No guide price available</p>
      <% end %>
    </div>

    <%# Discogs card %>
    <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-olive-900/5">
      <p class="text-xs font-semibold uppercase tracking-wide text-olive-500 mb-3">Discogs</p>
      <% if @record_with_valuation[:discogs_lowest_price].present? %>
        <p class="text-2xl font-semibold tabular-nums text-olive-950">
          $<%= number_with_delimiter(@record_with_valuation[:discogs_lowest_price].to_f.round(0)) %>
          <span class="text-sm font-normal text-olive-500">(lowest)</span>
        </p>
        <% if @record.discogs_release.present? %>
          <p class="mt-1 text-xs text-olive-500 truncate"><%= @record.discogs_release.title %></p>
          <% if @record.discogs_release.community_have.present? || @record.discogs_release.community_want.present? %>
            <p class="mt-1 text-xs text-olive-400">
              Have: <%= @record.discogs_release.community_have %> · Want: <%= @record.discogs_release.community_want %>
            </p>
          <% end %>
        <% end %>
      <% else %>
        <p class="text-sm text-olive-400">No Discogs match</p>
      <% end %>
    </div>
  </div>

  <%# Confidence badge %>
  <div class="mb-6 flex items-center gap-2">
    <span class="text-sm text-olive-600">Confidence:</span>
    <%= render "admin/records/confidence_badge", level: @record_with_valuation[:confidence_level] || Record.compute_confidence(@record_with_valuation) %>
  </div>

  <%# Edit form %>
  <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-olive-900/5">
    <% if @record.errors.any? %>
      <div class="mb-5 rounded-xl bg-red-50 p-4 ring-1 ring-red-200">
        <p class="text-sm font-medium text-red-700 mb-1">Please fix the following errors:</p>
        <ul class="list-disc list-inside text-sm text-red-600 space-y-0.5">
          <% @record.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @record, url: admin_record_path(@record), method: :patch, class: "space-y-5" do |f| %>
      <div>
        <%= f.label :value, "Personal Value ($)", class: "block text-sm font-medium text-olive-700 mb-1.5" %>
        <%= f.number_field :value, step: 1, min: 0,
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-olive-900 ring-1 ring-inset ring-olive-900/10 placeholder:text-olive-400 focus:ring-2 focus:ring-inset focus:ring-olive-600 sm:text-sm shadow-sm" %>
      </div>

      <div>
        <%= f.label :condition, "Condition", class: "block text-sm font-medium text-olive-700 mb-1.5" %>
        <%= f.select :condition, @conditions.map { |c| [c.titleize, c] },
            { include_blank: "— Select condition —" },
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-olive-900 ring-1 ring-inset ring-olive-900/10 focus:ring-2 focus:ring-inset focus:ring-olive-600 sm:text-sm shadow-sm bg-white" %>
      </div>

      <div>
        <%= f.label :comment, "Comment", class: "block text-sm font-medium text-olive-700 mb-1.5" %>
        <%= f.text_area :comment, rows: 3,
            class: "block w-full rounded-xl border-0 py-2.5 px-3.5 text-olive-900 ring-1 ring-inset ring-olive-900/10 placeholder:text-olive-400 focus:ring-2 focus:ring-inset focus:ring-olive-600 sm:text-sm shadow-sm resize-none" %>
      </div>

      <div class="flex items-center gap-4 pt-1">
        <%= f.submit "Save Changes",
            class: "inline-flex items-center px-5 py-2.5 text-sm font-medium rounded-full bg-olive-950 text-white hover:bg-olive-800 transition-colors cursor-pointer" %>
        <%= link_to "Cancel", admin_records_path, class: "text-sm text-olive-600 hover:text-olive-950 transition-colors" %>
      </div>
    <% end %>
  </div>
</div>
