<div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-4 mb-8">
  <div class="bg-white rounded-2xl shadow-sm ring-1 ring-olive-900/5 p-4">
    <div class="text-sm font-medium text-olive-600 leading-tight min-h-[2.25rem]">Total Records</div>
    <div class="mt-1 text-2xl font-semibold text-olive-950"><%= number_with_delimiter(stats[:total_count]) %></div>
  </div>

  <div class="bg-white rounded-2xl shadow-sm ring-1 ring-olive-900/5 p-4">
    <div class="text-sm font-medium text-olive-600 leading-tight min-h-[2.25rem]">Total Value</div>
    <div class="mt-1 text-2xl font-semibold text-olive-950">$<%= number_with_delimiter(stats[:total_value].round(0)) %></div>
  </div>

  <%# Shares the two cards above's scope: the filter dropdowns do not narrow it,
      a text search does. The denominator below is exactly Total Records. %>
  <%
    covered = stats[:discogs_covered].to_i
    coverage_pct = stats[:total_count] > 0 ? (covered.to_f / stats[:total_count] * 100).round(0) : 0
  %>
  <div class="bg-white rounded-2xl shadow-sm ring-1 ring-olive-900/5 p-4">
    <div class="text-sm font-medium text-olive-600 leading-tight min-h-[2.25rem]">Discogs Coverage</div>
    <div class="mt-1 text-2xl font-semibold text-olive-950 tabular-nums"><%= coverage_pct %>%</div>
    <div class="mt-0.5 text-xs text-olive-500 tabular-nums whitespace-nowrap"
         title="<%= number_with_delimiter(stats[:discogs_skipped]) %> deliberately skipped, counted as resolved">
      <%= number_with_delimiter(covered) %> / <%= number_with_delimiter(stats[:total_count]) %>
    </div>
  </div>

  <% %w[High Medium Low Suspect].each do |level| %>
    <%
      conf = stats[:confidence][level] || { count: 0, value: 0.0 }
      pct = stats[:total_value] > 0 ? (conf[:value] / stats[:total_value] * 100).round(1) : 0
      color = case level
              when "High"    then "text-emerald-600"
              when "Medium"  then "text-amber-600"
              when "Low"     then "text-orange-600"
              when "Suspect" then "text-red-600"
              end
    %>
    <div class="bg-white rounded-2xl shadow-sm ring-1 ring-olive-900/5 p-4">
      <div class="text-sm font-medium text-olive-600 leading-tight min-h-[2.25rem]"><%= level %> Confidence</div>
      <div class="mt-1 text-2xl font-semibold <%= color %>"><%= number_with_delimiter(conf[:count]) %></div>
      <div class="mt-0.5 text-xs text-olive-500">$<%= number_with_delimiter(conf[:value].round(0)) %> (<%= pct %>%)</div>
    </div>
  <% end %>
</div>
