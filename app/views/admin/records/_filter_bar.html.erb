<div class="flex flex-wrap items-center gap-3">
  <%# Price source + floor + top N row %>
  <div class="flex flex-wrap items-center gap-4 w-full pb-3 mb-1 border-b border-olive-100">
    <div class="flex items-center gap-1.5">
      <span class="text-xs font-semibold uppercase tracking-wide text-olive-500 mr-1">Source</span>
      <div class="relative group mr-1">
        <span id="price-source-info-trigger" tabindex="0" role="button" aria-describedby="price-source-info-tooltip"
              class="text-olive-300 cursor-help leading-none select-none text-xs">ⓘ</span>
        <div id="price-source-info-tooltip" role="tooltip"
             class="pointer-events-none absolute bottom-full left-0 mb-2 z-50 w-72
                    opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity duration-150">
          <div class="rounded-xl bg-olive-950 text-white p-4 shadow-lg text-xs leading-relaxed">
            <p class="font-semibold mb-2 text-olive-400 uppercase tracking-wide text-[10px]">Price source</p>
            <div class="space-y-1.5 text-olive-300">
              <p><span class="text-white font-medium">Best</span> — highest available price (Guide → My $ → Discogs)</p>
              <p><span class="text-white font-medium">Guide</span> — condition-adjusted Goldmine guide value</p>
              <p><span class="text-white font-medium">My $</span> — your personal valuation</p>
              <p><span class="text-white font-medium">Discogs</span> — current Discogs lowest listing</p>
            </div>
          </div>
        </div>
      </div>
      <% [["Best", "best"], ["Guide", "guide"], ["My $", "my"], ["Discogs", "discogs"]].each do |label, value| %>
        <% checked = (params[:price_source].blank? && value == "best") || params[:price_source] == value %>
        <label class="flex items-center gap-1 px-2.5 py-1.5 rounded-lg cursor-pointer text-xs font-medium transition-colors
                       bg-olive-200 text-olive-900 hover:bg-olive-300 has-[:checked]:bg-olive-950 has-[:checked]:text-white has-[:checked]:hover:bg-olive-950">
          <input type="radio" name="price_source" value="<%= value %>"
                 <%= "checked" if checked %>
                 data-action="change->auto-submit#submit"
                 class="sr-only">
          <%= label %>
        </label>
      <% end %>
    </div>

    <div class="flex items-center gap-1.5 ml-auto">
      <label for="top_n" class="text-xs font-medium text-olive-500">Show</label>
      <select id="top_n" name="top_n" data-action="change->auto-submit#submit"
              class="rounded-lg border-0 py-1.5 pl-2.5 pr-7 text-xs font-medium text-olive-700 ring-1 ring-inset ring-olive-900/10 focus:ring-2 focus:ring-olive-600 bg-white">
        <option value="">All</option>
        <% [100, 500, 1000, 2000].each do |n| %>
          <option value="<%= n %>" <%= "selected" if params[:top_n].to_s == n.to_s %>><%= number_with_delimiter(n) %></option>
        <% end %>
      </select>
    </div>
  </div>

  <%# Price histogram + dual-handle range slider %>
  <% if @price_distribution.present? && @price_boundaries.present? %>
    <% max_count = @price_distribution.max %>
    <% sqrt_max = max_count > 0 ? Math.sqrt(max_count) : 0 %>
    <div class="w-full pb-3 mb-1 border-b border-olive-100"
         data-controller="price-histogram"
         data-price-histogram-boundaries-value="<%= @price_boundaries.to_json %>"
         data-price-histogram-counts-value="<%= @price_distribution.to_json %>">
      <div class="flex items-center gap-4">
        <span class="text-xs font-semibold uppercase tracking-wide text-olive-500 w-20 shrink-0">Price</span>

        <div class="flex-1 min-w-0">
          <div class="relative h-12 select-none" data-price-histogram-target="track">
            <%# Bars %>
            <div class="absolute inset-x-0 bottom-1 top-0 flex items-stretch gap-px">
              <% @price_distribution.each_with_index do |count, i| %>
                <% h = sqrt_max > 0 ? (Math.sqrt(count) / sqrt_max * 100) : 0 %>
                <div class="flex-1 flex flex-col justify-end">
                  <div data-price-histogram-target="bar"
                       data-active="true"
                       class="w-full rounded-sm bg-olive-200 data-[active=true]:bg-olive-700 transition-colors duration-100"
                       style="height: <%= [h, 6].max.round(1) %>%;"
                       title="<%= number_with_delimiter(count) %> records"></div>
                </div>
              <% end %>
            </div>
            <%# Selection band (subtle highlight under the active range) %>
            <div data-price-histogram-target="selection"
                 class="absolute top-0 bottom-1 bg-olive-700/5 pointer-events-none rounded-sm"
                 style="left: 0%; width: 100%;"></div>
            <%# Handles (positioned absolutely over the bars) %>
            <button type="button" tabindex="0" role="slider" aria-label="Minimum price"
                    aria-orientation="horizontal" aria-valuemin="0" aria-valuemax="<%= @price_boundaries.last %>"
                    data-price-histogram-target="lowHandle"
                    data-action="pointerdown->price-histogram#startDragLow"
                    class="absolute top-0 -ml-2 h-[calc(100%-0.25rem)] w-4 cursor-ew-resize touch-none flex items-center justify-center group focus:outline-none"
                    style="left: 0%;">
              <span class="block w-1.5 h-full bg-olive-950 rounded-full ring-2 ring-white shadow-sm group-focus:ring-olive-600 group-hover:bg-black transition-colors"></span>
            </button>
            <button type="button" tabindex="0" role="slider" aria-label="Maximum price"
                    aria-orientation="horizontal" aria-valuemin="0" aria-valuemax="<%= @price_boundaries.last %>"
                    data-price-histogram-target="highHandle"
                    data-action="pointerdown->price-histogram#startDragHigh"
                    class="absolute top-0 -ml-2 h-[calc(100%-0.25rem)] w-4 cursor-ew-resize touch-none flex items-center justify-center group focus:outline-none"
                    style="left: 100%;">
              <span class="block w-1.5 h-full bg-olive-950 rounded-full ring-2 ring-white shadow-sm group-focus:ring-olive-600 group-hover:bg-black transition-colors"></span>
            </button>
          </div>
          <div class="flex items-center justify-between text-[11px] mt-1">
            <span class="text-olive-400 font-medium tabular-nums">$0</span>
            <span data-price-histogram-target="rangeLabel"
                  class="font-semibold text-olive-900 tabular-nums">Any price</span>
            <span class="text-olive-400 font-medium tabular-nums">$<%= @price_boundaries.last >= 1000 ? "#{@price_boundaries.last / 1000}k+" : "#{@price_boundaries.last}+" %></span>
          </div>

          <%# Exact numeric entry — these hold the real filter values; the slider
              handles are a visual approximation. Blank Max = no upper bound. %>
          <div class="flex items-center gap-3 mt-2">
            <label class="flex items-center gap-1.5 text-[11px] font-medium text-olive-500">
              Min
              <span class="relative">
                <span class="pointer-events-none absolute inset-y-0 left-2 flex items-center text-olive-400 text-xs">$</span>
                <input type="number" name="min_value" value="<%= params[:min_value] %>"
                       data-price-histogram-target="minInput"
                       data-action="change->price-histogram#onMinInput keydown->price-histogram#onInputKeydown"
                       inputmode="numeric" min="0" step="1" placeholder="No min" aria-label="Minimum price"
                       class="w-24 rounded-lg border-0 py-1 pl-5 pr-2 text-xs font-medium text-olive-900 ring-1 ring-inset ring-olive-900/10 focus:ring-2 focus:ring-olive-600 bg-white tabular-nums">
              </span>
            </label>
            <span class="text-olive-300 text-xs">–</span>
            <label class="flex items-center gap-1.5 text-[11px] font-medium text-olive-500">
              Max
              <span class="relative">
                <span class="pointer-events-none absolute inset-y-0 left-2 flex items-center text-olive-400 text-xs">$</span>
                <input type="number" name="max_value" value="<%= params[:max_value] %>"
                       data-price-histogram-target="maxInput"
                       data-action="change->price-histogram#onMaxInput keydown->price-histogram#onInputKeydown"
                       inputmode="numeric" min="0" step="1" placeholder="No max" aria-label="Maximum price"
                       class="w-24 rounded-lg border-0 py-1 pl-5 pr-2 text-xs font-medium text-olive-900 ring-1 ring-inset ring-olive-900/10 focus:ring-2 focus:ring-olive-600 bg-white tabular-nums">
              </span>
            </label>
          </div>
        </div>

        <button type="button" data-action="price-histogram#reset"
                class="text-xs font-medium text-olive-500 hover:text-olive-900 underline underline-offset-2 shrink-0">
          reset
        </button>
      </div>
    </div>
  <% end %>

  <%# Confidence pills — radio inputs so has-[:checked] drives active state without server re-render %>
  <div class="flex items-center gap-1.5 flex-wrap">
    <span class="text-xs font-semibold uppercase tracking-wide text-olive-500">Confidence</span>
    <div class="relative group mr-0.5">
      <span id="confidence-info-trigger" tabindex="0" role="button" aria-describedby="confidence-info-tooltip"
            class="text-olive-300 cursor-help leading-none select-none text-xs">ⓘ</span>
      <div id="confidence-info-tooltip" role="tooltip"
           class="pointer-events-none absolute bottom-full left-0 mb-2 z-50 w-72
                  opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity duration-150">
        <%= render "admin/records/confidence_legend" %>
      </div>
    </div>
    <% [["All", ""], ["High", "High"], ["Medium", "Medium"], ["Low", "Low"], ["Suspect", "Suspect"]].each do |label, value| %>
      <% checked = (value == "" && params[:confidence].blank?) || params[:confidence] == value %>
      <label class="px-3 py-1.5 text-xs font-medium rounded-full cursor-pointer transition-all
                     bg-olive-200 text-olive-950 hover:bg-olive-300 has-[:checked]:bg-olive-950 has-[:checked]:text-white has-[:checked]:hover:bg-olive-950">
        <input type="radio" name="confidence" value="<%= value %>"
               <%= "checked" if checked %>
               data-action="change->auto-submit#submit"
               class="sr-only">
        <%= label %>
      </label>
    <% end %>
  </div>

  <%# Type pills — multi-select checkboxes (matches public /records q[record_type_id_in][] pattern) %>
  <% if @record_types.present? %>
    <div class="flex items-center gap-1.5 flex-wrap">
      <span class="text-xs font-semibold uppercase tracking-wide text-olive-500">Type</span>
      <% selected_type_ids = Array(params[:record_type_id_in]).map(&:to_s) %>
      <% @record_types.each do |t| %>
        <% checked = selected_type_ids.include?(t[:id].to_s) %>
        <label class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-full cursor-pointer transition-all
                       bg-olive-200 text-olive-950 hover:bg-olive-300 has-[:checked]:bg-olive-950 has-[:checked]:text-white has-[:checked]:hover:bg-olive-950">
          <input type="checkbox" name="record_type_id_in[]" value="<%= t[:id] %>"
                 <%= "checked" if checked %>
                 data-action="change->auto-submit#submit"
                 class="sr-only">
          <span><%= t[:name] %></span>
          <span class="opacity-70 tabular-nums"><%= number_with_delimiter(t[:count]) %></span>
        </label>
      <% end %>
    </div>
  <% end %>

  <%# Dropdowns row — all together so they never wrap apart %>
  <div class="flex flex-wrap items-center gap-3 w-full">
    <select name="pricing" aria-label="Pricing filter" data-action="change->auto-submit#submit"
            class="rounded-lg border-0 py-1.5 pl-3 pr-8 text-xs font-medium text-olive-700 ring-1 ring-inset ring-olive-900/10 focus:ring-2 focus:ring-olive-600 bg-white">
      <option value="">All Pricing</option>
      <option value="has_guide" <%= "selected" if params[:pricing] == "has_guide" %>>Has Guide Price</option>
      <option value="has_personal" <%= "selected" if params[:pricing] == "has_personal" %>>Has Personal Value</option>
      <option value="has_discogs" <%= "selected" if params[:pricing] == "has_discogs" %>>Has Discogs Price</option>
      <option value="no_price" <%= "selected" if params[:pricing] == "no_price" %>>No Price Data</option>
    </select>

    <% if @conditions.present? %>
      <select name="condition" aria-label="Condition filter" data-action="change->auto-submit#submit"
              class="rounded-lg border-0 py-1.5 pl-3 pr-8 text-xs font-medium text-olive-700 ring-1 ring-inset ring-olive-900/10 focus:ring-2 focus:ring-olive-600 bg-white">
        <option value="">All Conditions</option>
        <% @conditions.each do |c| %>
          <option value="<%= c[:value] %>" <%= "selected" if params[:condition] == c[:value] %>><%= c[:value]&.titleize %> (<%= c[:count] %>)</option>
        <% end %>
      </select>
    <% end %>

    <% if @genres.present? %>
      <select name="genre_id" aria-label="Genre filter" data-action="change->auto-submit#submit"
              class="rounded-lg border-0 py-1.5 pl-3 pr-8 text-xs font-medium text-olive-700 ring-1 ring-inset ring-olive-900/10 focus:ring-2 focus:ring-olive-600 bg-white">
        <option value="">All Genres</option>
        <% @genres.each do |g| %>
          <option value="<%= g[:id] %>" <%= "selected" if params[:genre_id].to_s == g[:id].to_s %>><%= g[:name] %> (<%= g[:count] %>)</option>
        <% end %>
      </select>
    <% end %>

    <select name="images" aria-label="Images filter" data-action="change->auto-submit#submit"
            class="rounded-lg border-0 py-1.5 pl-3 pr-8 text-xs font-medium text-olive-700 ring-1 ring-inset ring-olive-900/10 focus:ring-2 focus:ring-olive-600 bg-white">
      <option value="">All Images</option>
      <option value="has" <%= "selected" if params[:images] == "has" %>>Has images (<%= number_with_delimiter(@images_counts[:has]) %>)</option>
      <option value="missing" <%= "selected" if params[:images] == "missing" %>>Missing images (<%= number_with_delimiter(@images_counts[:missing]) %>)</option>
    </select>

    <select name="audio" aria-label="Audio filter" data-action="change->auto-submit#submit"
            class="rounded-lg border-0 py-1.5 pl-3 pr-8 text-xs font-medium text-olive-700 ring-1 ring-inset ring-olive-900/10 focus:ring-2 focus:ring-olive-600 bg-white">
      <option value="">All Audio</option>
      <option value="has" <%= "selected" if params[:audio] == "has" %>>Has audio (<%= number_with_delimiter(@audio_counts[:has]) %>)</option>
      <option value="missing" <%= "selected" if params[:audio] == "missing" %>>Missing audio (<%= number_with_delimiter(@audio_counts[:missing]) %>)</option>
    </select>

    <%# Clear filters %>
    <% if params.slice(:search, :confidence, :pricing, :condition, :genre_id, :record_type_id_in, :min_value, :max_value, :price_source, :top_n, :images, :audio).values.any?(&:present?) %>
      <%= link_to "Clear filters", admin_records_path,
          class: "text-xs font-medium text-olive-500 hover:text-olive-700 underline underline-offset-2" %>
    <% end %>
  </div>
</div>
