<div class="flex flex-wrap items-center gap-3">
  <%# Confidence pills %>
  <div class="flex gap-1.5 flex-wrap">
    <%
      confidence_options = [["All", nil], ["High", "High"], ["Medium", "Medium"], ["Low", "Low"], ["Suspect", "Suspect"]]
    %>
    <% confidence_options.each do |label, value| %>
      <%
        active = params[:confidence].to_s == value.to_s
        # Use link-based navigation instead of hidden radio for Turbo Frame compatibility
      %>
      <% if value.nil? %>
        <%= link_to label,
            admin_records_path(request.query_parameters.except("confidence", "page")),
            data: { turbo_frame: "admin_records_list" },
            class: "px-3 py-1.5 text-xs font-medium rounded-full transition-all #{params[:confidence].blank? ? 'bg-olive-950 text-white' : 'bg-olive-200 text-olive-950 hover:bg-olive-300'}" %>
      <% else %>
        <%= link_to label,
            admin_records_path(request.query_parameters.merge(confidence: value).except("page")),
            data: { turbo_frame: "admin_records_list" },
            class: "px-3 py-1.5 text-xs font-medium rounded-full transition-all #{params[:confidence] == value ? 'bg-olive-950 text-white' : 'bg-olive-200 text-olive-950 hover:bg-olive-300'}" %>
      <% end %>
    <% end %>
  </div>

  <div class="h-6 w-px bg-olive-200"></div>

  <%# Value tier dropdown %>
  <select name="tier" data-action="change->auto-submit#submit"
          class="rounded-lg border-0 py-1.5 pl-3 pr-8 text-xs font-medium text-olive-700 ring-1 ring-inset ring-olive-900/10 focus:ring-2 focus:ring-olive-600 bg-white">
    <option value="">All Values</option>
    <% Admin::RecordsController::VALUE_TIERS.each do |label, _, _| %>
      <option value="<%= label %>" <%= "selected" if params[:tier] == label %>><%= label %></option>
    <% end %>
  </select>

  <%# Pricing status dropdown %>
  <select name="pricing" data-action="change->auto-submit#submit"
          class="rounded-lg border-0 py-1.5 pl-3 pr-8 text-xs font-medium text-olive-700 ring-1 ring-inset ring-olive-900/10 focus:ring-2 focus:ring-olive-600 bg-white">
    <option value="">All Pricing</option>
    <option value="has_guide" <%= "selected" if params[:pricing] == "has_guide" %>>Has Guide Price</option>
    <option value="has_personal" <%= "selected" if params[:pricing] == "has_personal" %>>Has Personal Value</option>
    <option value="has_discogs" <%= "selected" if params[:pricing] == "has_discogs" %>>Has Discogs Price</option>
    <option value="no_price" <%= "selected" if params[:pricing] == "no_price" %>>No Price Data</option>
  </select>

  <%# Condition dropdown %>
  <% if @conditions.present? %>
    <select name="condition" data-action="change->auto-submit#submit"
            class="rounded-lg border-0 py-1.5 pl-3 pr-8 text-xs font-medium text-olive-700 ring-1 ring-inset ring-olive-900/10 focus:ring-2 focus:ring-olive-600 bg-white">
      <option value="">All Conditions</option>
      <% @conditions.each do |c| %>
        <option value="<%= c[:value] %>" <%= "selected" if params[:condition] == c[:value] %>><%= c[:value]&.titleize %> (<%= c[:count] %>)</option>
      <% end %>
    </select>
  <% end %>

  <%# Genre dropdown %>
  <% if @genres.present? %>
    <select name="genre_id" data-action="change->auto-submit#submit"
            class="rounded-lg border-0 py-1.5 pl-3 pr-8 text-xs font-medium text-olive-700 ring-1 ring-inset ring-olive-900/10 focus:ring-2 focus:ring-olive-600 bg-white">
      <option value="">All Genres</option>
      <% @genres.each do |g| %>
        <option value="<%= g[:id] %>" <%= "selected" if params[:genre_id].to_s == g[:id].to_s %>><%= g[:name] %> (<%= g[:count] %>)</option>
      <% end %>
    </select>
  <% end %>

  <%# Format dropdown %>
  <% if @formats.present? %>
    <select name="format_id" data-action="change->auto-submit#submit"
            class="rounded-lg border-0 py-1.5 pl-3 pr-8 text-xs font-medium text-olive-700 ring-1 ring-inset ring-olive-900/10 focus:ring-2 focus:ring-olive-600 bg-white">
      <option value="">All Formats</option>
      <% @formats.each do |f| %>
        <option value="<%= f[:id] %>" <%= "selected" if params[:format_id].to_s == f[:id].to_s %>><%= f[:name] %> (<%= f[:count] %>)</option>
      <% end %>
    </select>
  <% end %>

  <%# Clear filters %>
  <% if params.slice(:search, :confidence, :tier, :pricing, :condition, :genre_id, :format_id, :min_value, :max_value).values.any?(&:present?) %>
    <%= link_to "Clear filters", admin_records_path,
        class: "text-xs font-medium text-olive-500 hover:text-olive-700 underline underline-offset-2" %>
  <% end %>
</div>
