<%#
  Locals:
    artist_source, label_source, format_source — CSS selectors of sibling form ID inputs (optional)
    artist_name_source, label_name_source, format_name_source — CSS selectors of inputs holding human-readable names (optional)
    default_artist_id, default_label_id, default_format_id — server-rendered ID defaults (optional)
    default_artist_name, default_label_name, default_format_name — server-rendered name defaults (optional)
    default_yearbegin, default_yearend, default_price_low, default_price_high — pre-fill price fields (optional, used for "Create variant")
    default_detail, default_media_type, default_footnote — pre-fill descriptive fields (optional)
    price_id_hidden_selector, price_label_selector — selectors for the autocomplete to populate (optional)
    link_url — chain a POST after create (optional, used by Price Review)
    panel_id — DOM id prefix so the partial can be rendered more than once on a page (optional, default "price-create")
    button_label — text on the open-trigger button (optional, default "Create new price guide entry")
%>
<% artist_source ||= nil; label_source ||= nil; format_source ||= nil %>
<% artist_name_source ||= nil; label_name_source ||= nil; format_name_source ||= nil %>
<% default_artist_id ||= nil; default_label_id ||= nil; default_format_id ||= nil %>
<% default_artist_name ||= nil; default_label_name ||= nil; default_format_name ||= nil %>
<% default_yearbegin ||= nil; default_yearend ||= nil %>
<% default_price_low ||= nil; default_price_high ||= nil %>
<% default_detail ||= nil; default_media_type ||= nil; default_footnote ||= nil %>
<% price_id_hidden_selector ||= nil; price_label_selector ||= nil; link_url ||= nil %>
<% panel_id ||= "price-create" %>
<% button_label ||= "Create new price guide entry" %>
<%
  panel_data = { controller: "price-create-toggle" }
  panel_data[:"price-create-toggle-artist-source-value"] = artist_source if artist_source
  panel_data[:"price-create-toggle-label-source-value"] = label_source if label_source
  panel_data[:"price-create-toggle-format-source-value"] = format_source if format_source
  panel_data[:"price-create-toggle-artist-name-source-value"] = artist_name_source if artist_name_source
  panel_data[:"price-create-toggle-label-name-source-value"] = label_name_source if label_name_source
  panel_data[:"price-create-toggle-format-name-source-value"] = format_name_source if format_name_source
  panel_data[:"price-create-toggle-price-id-hidden-value"] = price_id_hidden_selector if price_id_hidden_selector
  panel_data[:"price-create-toggle-price-label-value"] = price_label_selector if price_label_selector
  panel_data[:"price-create-toggle-link-url-value"] = link_url if link_url
%>
<%= tag.div(data: panel_data, class: "mt-2") do %>
  <button type="button"
          data-action="click->price-create-toggle#open"
          data-price-create-toggle-target="trigger"
          class="inline-flex items-center gap-1 text-xs font-medium text-emerald-700 hover:text-emerald-900 transition-colors">
    <span>+</span>
    <span><%= button_label %></span>
  </button>

  <div data-price-create-toggle-target="panel" hidden
       class="mt-3 rounded-xl border border-olive-200 bg-olive-50/50 p-4 space-y-4">
    <div class="rounded-lg bg-white px-3 py-2 ring-1 ring-olive-200">
      <p class="text-xs uppercase tracking-wide text-olive-500 font-medium">New entry will link</p>
      <p class="text-sm text-olive-900 mt-0.5">
        <span data-price-create-toggle-target="artistName" class="font-medium"><%= default_artist_name || "—" %></span>
        <span class="text-olive-400 mx-1">·</span>
        <span data-price-create-toggle-target="labelName"><%= default_label_name || "—" %></span>
        <span class="text-olive-400 mx-1">·</span>
        <span data-price-create-toggle-target="formatName"><%= default_format_name || "—" %></span>
      </p>
      <p class="text-xs text-olive-500 mt-1">Change these on the record above before creating, if wrong.</p>
    </div>

    <ul data-price-create-toggle-target="errors" hidden
        class="rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 list-disc list-inside ring-1 ring-red-200"></ul>

    <input type="hidden" data-price-create-toggle-target="artistIdInput" value="<%= default_artist_id %>">
    <input type="hidden" data-price-create-toggle-target="labelIdInput" value="<%= default_label_id %>">
    <input type="hidden" data-price-create-toggle-target="formatIdInput" value="<%= default_format_id %>">

    <div class="grid grid-cols-2 gap-3">
      <div>
        <label for="<%= panel_id %>-yearbegin" class="block text-xs font-medium text-olive-700 mb-1">Year begin</label>
        <input type="number" id="<%= panel_id %>-yearbegin" data-price-create-toggle-target="yearbegin" min="1801" max="2099"
               value="<%= default_yearbegin %>"
               class="block w-full rounded-lg border-olive-300 shadow-sm focus:border-olive-500 focus:ring-olive-500 text-sm">
      </div>
      <div>
        <label for="<%= panel_id %>-yearend" class="block text-xs font-medium text-olive-700 mb-1">Year end</label>
        <input type="number" id="<%= panel_id %>-yearend" data-price-create-toggle-target="yearend" min="1801" max="2099"
               value="<%= default_yearend %>"
               class="block w-full rounded-lg border-olive-300 shadow-sm focus:border-olive-500 focus:ring-olive-500 text-sm">
      </div>
      <div>
        <label for="<%= panel_id %>-price-low" class="block text-xs font-medium text-olive-700 mb-1">Price low ($)</label>
        <input type="number" id="<%= panel_id %>-price-low" data-price-create-toggle-target="priceLow" min="0" step="1"
               value="<%= default_price_low %>"
               class="block w-full rounded-lg border-olive-300 shadow-sm focus:border-olive-500 focus:ring-olive-500 text-sm">
      </div>
      <div>
        <label for="<%= panel_id %>-price-high" class="block text-xs font-medium text-olive-700 mb-1">Price high ($)</label>
        <input type="number" id="<%= panel_id %>-price-high" data-price-create-toggle-target="priceHigh" min="0" step="1"
               value="<%= default_price_high %>"
               class="block w-full rounded-lg border-olive-300 shadow-sm focus:border-olive-500 focus:ring-olive-500 text-sm">
      </div>
    </div>

    <div>
      <label for="<%= panel_id %>-detail" class="block text-xs font-medium text-olive-700 mb-1">Detail</label>
      <input type="text" id="<%= panel_id %>-detail" data-price-create-toggle-target="detail"
             placeholder='e.g. 147 "At My Front Door"'
             value="<%= default_detail %>"
             class="block w-full rounded-lg border-olive-300 shadow-sm focus:border-olive-500 focus:ring-olive-500 text-sm">
    </div>

    <div>
      <label for="<%= panel_id %>-media-type" class="block text-xs font-medium text-olive-700 mb-1">Media type</label>
      <input type="text" id="<%= panel_id %>-media-type" data-price-create-toggle-target="mediaType"
             placeholder="e.g. Black vinyl"
             value="<%= default_media_type %>"
             class="block w-full rounded-lg border-olive-300 shadow-sm focus:border-olive-500 focus:ring-olive-500 text-sm">
    </div>

    <div>
      <label for="<%= panel_id %>-footnote" class="block text-xs font-medium text-olive-700 mb-1">Footnote</label>
      <textarea id="<%= panel_id %>-footnote" data-price-create-toggle-target="footnote" rows="2"
                class="block w-full rounded-lg border-olive-300 shadow-sm focus:border-olive-500 focus:ring-olive-500 text-sm"><%= default_footnote %></textarea>
    </div>

    <div class="flex items-center justify-end gap-2">
      <button type="button" data-action="click->price-create-toggle#close"
              class="inline-flex items-center px-3 py-1.5 border border-olive-300 shadow-sm text-xs font-medium rounded-lg text-olive-700 bg-white hover:bg-olive-100 transition-colors">
        Cancel
      </button>
      <button type="button" data-action="click->price-create-toggle#submit"
              data-price-create-toggle-target="submitButton"
              class="inline-flex items-center px-3 py-1.5 border border-transparent shadow-sm text-xs font-medium rounded-lg text-white bg-emerald-700 hover:bg-emerald-800 disabled:opacity-50 transition-colors">
        Use this entry
      </button>
    </div>
  </div>
<% end %>
